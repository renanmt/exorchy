# Maintainer: Renan Tonheiro <renan.tonheiro@gmail.com>
# AUR package: copy this file into the AUR git repo, run updpkgsums and
# makepkg --printsrcinfo > .SRCINFO (see docs/RELEASING.md). packaging/PKGBUILD
# builds a local checkout instead.
pkgname=exorchy
pkgver=0.6.0
pkgrel=1
pkgdesc="Omarchy-native launcher for the eXo collections (eXoDOS, eXoWin3x, eXoWin9x, eXoScummVM)"
arch=('x86_64')
url="https://github.com/renanmt/exorchy"
license=('MIT')
depends=('gtk4' 'libadwaita' 'poppler-glib' 'gstreamer' 'gst-plugins-base'
         'openssl' 'xdg-utils' 'hicolor-icon-theme')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=('gst-plugins-good: preview videos and theme music'
            'gst-libav: H.264 preview videos'
            'dosbox-staging: use a system emulator instead of the downloaded pack')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/renanmt/exorchy/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p exorchy
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release -p exorchy-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/exorchy "$pkgdir/usr/bin/exorchy"

  install -d "$pkgdir/usr/lib/exorchy"
  cp -r metadata "$pkgdir/usr/lib/exorchy/metadata"
  rm -f "$pkgdir/usr/lib/exorchy/metadata/"*.db \
        "$pkgdir/usr/lib/exorchy/metadata/"*.db-shm \
        "$pkgdir/usr/lib/exorchy/metadata/"*.db-wal
  cp -r torrents "$pkgdir/usr/lib/exorchy/torrents"
  install -Dm644 manifest.json "$pkgdir/usr/lib/exorchy/manifest.json"
  cp -r crates/core/resources/previews "$pkgdir/usr/lib/exorchy/previews"

  install -Dm644 packaging/org.exorchy.eXorchy.desktop \
    "$pkgdir/usr/share/applications/org.exorchy.eXorchy.desktop"
  for s in 32 128 256 512; do
    install -Dm644 "packaging/icons/${s}x${s}.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/exorchy.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ACKNOWLEDGEMENTS.md "$pkgdir/usr/share/doc/$pkgname/ACKNOWLEDGEMENTS.md"
}
