{
  "name": "exorchy",
  "version": "0.1.0",
  "description": "Omarchy-native launcher for the eXoDOS collection",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "cargo test --manifest-path src-tauri/Cargo.toml && vitest run",
    "gen-db": "cd src-tauri && cargo run --release --example generate_db && cd .. && gzip -kf metadata/exorchy.db",
    "predev": "node scripts/copy-pdfjs-wasm.mjs",
    "prebuild": "node scripts/copy-pdfjs-wasm.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@ark-ui/solid": "^5.35.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-solid": "^1.47.0",
    "pdfjs-dist": "5.6.205",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "jsdom": "^25",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2"
  }
}